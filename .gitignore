__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
.mypy_cache/
.hypothesis/
htmlcov/
*.egg-info/
dist/
build/

# Raw dataset archives are re-downloadable; keep the repo light.
data/raw/
*.Z
*.zip

# Trained weights are regenerable via scripts/train.py, but the final
# small model IS committed so the app runs without retraining.
models/*.tmp

# AlphaZero run state. The promoted champion is worth committing -- it is a
# quarter of a megabyte and it is the artefact -- but the per-iteration
# challenger and the append-only log are run scratch.
checkpoints/*/challenger.pt
checkpoints/*/training_log.jsonl

# Local game log. It is one player's session history, not project source.
data/games.jsonl

# Claude Code session state -- machine-local, never shared.
.claude/

# mutmut copies the tree it mutates into ./mutants and caches verdicts beside
# it. Both are derived from the source and are rebuilt on every run.
mutants/
.mutmut-cache
mutmut-stats.json
